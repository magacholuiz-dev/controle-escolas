PORT=3200
MONGODB_URI=mongodb://127.0.0.1:27019/controle-escolas
LISTEN_HOST=127.0.0.1

# Loop 8 (login). The first user (owner) is created from these two on the very first boot, when
# there are no users yet — after that, the owner creates every other user (directors) from the app.
SEED_OWNER_EMAIL=dona@example.com
SEED_OWNER_PASSWORD=change-this-password

# Session cookie lifetime, in hours.
SESSION_TTL_HOURS=168

# Set to 1 only once the app is served over HTTPS (e.g. behind a reverse proxy in production) — a
# `Secure` cookie is never sent back over plain HTTP, so leave this at 0 for local/dev use. This
# also switches the session cookie's SameSite from Strict to None, which is what a cross-origin
# front (e.g. the static site on Vercel calling this API on the droplet) needs to receive it at all.
COOKIE_SECURE=0

# Comma-separated list of extra origins allowed to call this API with credentials (cookies), for
# when the front is served from a different origin than the API. Any https://*.vercel.app origin
# is always allowed already, so this is only for a custom domain in front of the static site.
CORS_ORIGINS=
