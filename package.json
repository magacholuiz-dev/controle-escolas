{
  "name": "controle-escolas-monorepo",
  "private": true,
  "version": "2.0.0",
  "description": "Financial control for two preschools — TypeScript monorepo (NestJS API, Next.js web, shared domain)",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "db": "docker compose up -d",
    "db:down": "docker compose down",
    "test:contract": "node --test \"contract/*.test.js\"",
    "test:contract:legacy": "API_CMD=\"node legacy/server.js\" node --test \"contract/*.test.js\"",
    "test:contract:api": "API_CMD=\"node apps/api/dist/main.js\" node --test \"contract/*.test.js\"",
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "golden": "node contract/golden/generate.mjs"
  },
  "devDependencies": {
    "mongoose": "^9.4.1",
    "typescript": "^5.7.3"
  },
  "engines": { "node": ">=23.4" }
}
